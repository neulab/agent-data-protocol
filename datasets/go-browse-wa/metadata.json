    },
    {
      "type": "function",
      "function": {
        "name": "noop",
        "description": "Do nothing, and optionally wait for the given time (in milliseconds).",
        "parameters": {
          "type": "object",
          "properties": {
            "wait_ms": {
              "type": "number",
              "description": "Time to wait in milliseconds. Defaults to 1000ms."
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "press",
        "description": "Focus the matching element and press a combination of keys.",
        "parameters": {
          "type": "object",
          "properties": {
            "bid": {
              "type": "string",
              "description": "The browser ID of the element to focus."
            },
            "key_comb": {
              "type": "string",
              "description": "The key combination to press (e.g., \"Backspace\", \"ControlOrMeta+a\")."
            }
          },
          "additionalProperties": false,
          "required": [
            "bid",
            "key_comb"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "scroll",
        "description": "Scroll horizontally and vertically.\n\nAmounts in pixels, positive for right or down scrolling,\nnegative for left or up scrolling. Dispatches a wheel event.",
        "parameters": {
          "type": "object",
          "properties": {
            "delta_x": {
              "type": "number",
              "description": "The distance to scroll horizontally in pixels."
            },
            "delta_y": {
              "type": "number",
              "description": "The distance to scroll vertically in pixels."
            }
          },
          "additionalProperties": false,
          "required": [
            "delta_x",
            "delta_y"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "select_option",
        "description": "Select one or multiple options in a <select> element.",
        "parameters": {
          "type": "object",
          "properties": {
            "bid": {
              "type": "string",
              "description": "The browser ID of the select element."
            },
            "options": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ],
              "description": "The option value(s) or label(s) to select."
            }
          },
          "additionalProperties": false,
          "required": [
            "bid",
            "options"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "upload_file",
        "description": "Click an element and wait for a \"filechooser\" event, then select file(s) for upload.",
        "parameters": {
          "type": "object",
          "properties": {
            "bid": {
              "type": "string",
              "description": "The browser ID of the file input element."
            },
            "file": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ],
              "description": "Path(s) to the file(s) to upload."
            }
          },
          "additionalProperties": false,
          "required": [
            "bid",
            "file"
          ]
        }
      }
    }
  ],
  "code_enabled": [],
  "browser_enabled": true
}
