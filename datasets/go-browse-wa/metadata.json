{
  "custom_tools": [
    {
      "type": "function",
      "function": {
        "name": "clear",
        "description": "Clear the input field.",
        "parameters": {
          "type": "object",
          "properties": {
            "bid": {
              "type": "string",
              "description": "The browser ID of the input field to clear."
            }
          },
          "additionalProperties": false,
          "required": [
            "bid"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "click",
        "description": "Click an element.",
        "parameters": {
          "type": "object",
          "properties": {
            "bid": {
              "type": "string",
              "description": "The browser ID of the element to click."
            },
            "button": {
              "enum": [
                "left",
                "middle",
                "right"
              ],
              "type": "string",
              "description": "The mouse button to use. Defaults to \"left\"."
            },
            "modifiers": {
              "items": {
                "enum": [
                  "Alt",
                  "Control",
                  "ControlOrMeta",
                  "Meta",
                  "Shift"
                ],
                "type": "string"
              },
              "type": "array",
              "description": "List of modifier keys to hold while clicking. Defaults to None."
            }
          },
          "additionalProperties": false,
          "required": [
            "bid"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "dblclick",
        "description": "Double click an element.",
        "parameters": {
          "type": "object",
          "properties": {
            "bid": {
              "type": "string",
              "description": "The browser ID of the element to double click."
            },
            "button": {
              "enum": [
                "left",
                "middle",
                "right"
              ],
              "type": "string",
              "description": "The mouse button to use. Defaults to \"left\"."
            },
            "modifiers": {
              "items": {
                "enum": [
                  "Alt",
                  "Control",
                  "ControlOrMeta",
                  "Meta",
                  "Shift"
                ],
                "type": "string"
              },
              "type": "array",
              "description": "List of modifier keys to hold while double clicking. Defaults to None."
            }
          },
          "additionalProperties": false,
          "required": [
            "bid"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "drag_and_drop",
        "description": "Perform a drag & drop operation.",
        "parameters": {
          "type": "object",
          "properties": {
            "from_bid": {
              "type": "string",
              "description": "The browser ID of the element to drag."
            },
            "to_bid": {
              "type": "string",
              "description": "The browser ID of the element to drop onto."
            }
          },
          "additionalProperties": false,
          "required": [
            "from_bid",
            "to_bid"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "fill",
        "description": "Fill out a form field.\n\nIt focuses the element and triggers an input event with the entered text.\nWorks for <input>, <textarea> and [contenteditable] elements.",
        "parameters": {
          "type": "object",
          "properties": {
            "bid": {
              "type": "string",
              "description": "The browser ID of the element to fill."
            },
            "value": {
              "type": "string",
              "description": "The text to enter into the field."
            }
          },
          "additionalProperties": false,
          "required": [
            "bid",
            "value"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "focus",
        "description": "Focus the matching element.",
        "parameters": {
          "type": "object",
          "properties": {
            "bid": {
              "type": "string",
              "description": "The browser ID of the element to focus."
            }
          },
          "additionalProperties": false,
          "required": [
            "bid"
          ]
        }
      }
    },
    {
