{
  "custom_tools": [
    {
      "type": "function",
      "function": {
        "name": "click",
        "description": "Click on an element with the given id.",
        "parameters": {
          "type": "object",
          "properties": {
            "bid": {
              "type": "string",
              "description": "The id of the element to click on."
            }
          },
          "additionalProperties": false,
          "required": [
            "bid"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "close_tab",
        "description": "Close the current tab.",
        "parameters": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "new_tab",
        "description": "Open a new tab with the given URL.",
        "parameters": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL to open in the new tab."
            }
          },
          "additionalProperties": false,
          "required": [
            "url"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "press",
        "description": "Press a key combination.",
        "parameters": {
          "type": "object",
          "properties": {
            "key_comb": {
              "type": "string",
              "description": "The key combination to press. For example, \"Ctrl+C\". This is system specific."
            }
          },
          "additionalProperties": false,
          "required": [
            "key_comb"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "scroll",
        "description": "Scroll horizontally and/or vertically in pixels.",
        "parameters": {
          "type": "object",
          "properties": {
            "delta_x": {
              "type": "number",
              "description": "Horizontal scroll in pixels."
            },
            "delta_y": {
              "type": "number",
              "description": "Vertical scroll in pixels."
            }
          },
          "additionalProperties": false,
          "required": [
            "delta_x",
            "delta_y"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "stop",
        "description": "Stop the execution of the trajectory.",
        "parameters": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "description": "The answer to the question. This is optional since a task may not require an answer."
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "tab_focus",
        "description": "Focus on the tab with the given page_number.",
        "parameters": {
          "type": "object",
          "properties": {
            "page_number": {
              "type": "integer",
              "description": "The page_number of the tab to focus on. Starts from 0."
            }
          },
          "additionalProperties": false,
          "required": [
            "page_number"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "type",
