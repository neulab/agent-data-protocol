          "type": "object",
          "properties": {
            "bid": {
              "type": "string"
            },
            "button": {
              "type": "string",
              "enum": [
                "left",
                "middle",
                "right"
              ]
            },
            "modifiers": {
              "type": "array"
            }
          },
          "additionalProperties": false,
          "required": [
            "bid"
          ]
        }
      }
    },
