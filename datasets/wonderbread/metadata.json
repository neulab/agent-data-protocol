        "name": "keyboard_press",
        "description": "Press the key.\n\nValid keys are defined in https://playwright.dev/python/docs/api/class-keyboard#keyboard-press",
        "parameters": {
          "type": "object",
          "properties": {
            "xpath": {
              "type": "string",
              "description": "the xpath of the selected element."
            },
            "value": {
              "type": "string",
              "description": "the key to press."
            }
          },
          "additionalProperties": false,
          "required": [
            "xpath",
            "value"
          ]
        }
      }
