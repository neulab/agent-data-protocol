          "properties": {
            "xpath": {
              "type": "string",
              "description": "The xpath of the element to type into."
            },
            "value": {
              "type": "string",
              "description": "The text to type."
            }
          },
          "additionalProperties": false,
          "required": [
            "xpath",
            "value"
          ]
        }
      }
